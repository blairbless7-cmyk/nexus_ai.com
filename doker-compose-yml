version: '3.8'
services:
  nexus-db:
      image: postgres:15-alpine
          env_file: .env
              ports: ["5432:5432"]
                nexus-backend:
                    build: ./backend
                        env_file: .env
                            ports: ["8000:8000"]
                                depends_on: [nexus-db]
                                    # REMOVED: docker.sock mount - critical security fix
                                    version: '3.8'

                                    services:
                                      nexus-db:
                                          image: postgres:15-alpine
                                              container_name: nexus_db
                                                  restart: always
                                                      environment:
                                                            POSTGRES_USER: nexus_admin
                                                                  POSTGRES_PASSWORD: super_secure_local_dev_password
                                                                        POSTGRES_DB: nexus_ai_ledger
                                                                            ports:
                                                                                  - "5432:5432"
                                                                                      volumes:
                                                                                            - postgres_data:/var/lib/postgresql/data
                                                                                                  - ./backend/init_db.py:/docker-entrypoint-initdb.d/init.py
                                                                                                      healthcheck:
                                                                                                            test: ["CMD-SHELL", "pg_isready -U nexus_admin -d nexus_ai_ledger"]
                                                                                                                  interval: 5s
                                                                                                                        timeout: 5s
                                                                                                                              retries: 10

                                                                                                                                nexus-api:
                                                                                                                                    build:
                                                                                                                                          context: ./backend
                                                                                                                                                dockerfile: Dockerfile
                                                                                                                                                    container_name: nexus_api
                                                                                                                                                        restart: always
                                                                                                                                                            depends_on:
                                                                                                                                                                  nexus-db:
                                                                                                                                                                          condition: service_healthy
                                                                                                                                                                              environment:
                                                                                                                                                                                    DATABASE_URL: postgresql://nexus_admin:super_secure_local_dev_password@nexus-db:5432/nexus_ai_ledger
                                                                                                                                                                                          JWT_SECRET_KEY: ${JWT_SECRET_KEY:-change-this-to-random-32-char-secret-in-production}
                                                                                                                                                                                                STRIPE_SECRET_KEY: ${STRIPE_SECRET_KEY:-sk_test_placeholder}
                                                                                                                                                                                                      STRIPE_WEBHOOK_SECRET: ${STRIPE_WEBHOOK_SECRET:-whsec_placeholder}
                                                                                                                                                                                                          ports:
                                                                                                                                                                                                                - "8000:8000"
                                                                                                                                                                                                                    volumes:
                                                                                                                                                                                                                          - ./backend:/app
                                                                                                                                                                                                                              command: uvicorn main:app --host 0.0.0.0 --port 8000 --reload

                                                                                                                                                                                                                                nexus-frontend:
                                                                                                                                                                                                                                    build:
                                                                                                                                                                                                                                          context: ./frontend
                                                                                                                                                                                                                                                dockerfile: Dockerfile
                                                                                                                                                                                                                                                    container_name: nexus_frontend
                                                                                                                                                                                                                                                        restart: always
                                                                                                                                                                                                                                                            depends_on:
                                                                                                                                                                                                                                                                  - nexus-api
                                                                                                                                                                                                                                                                      ports:
                                                                                                                                                                                                                                                                            - "3000:3000"
                                                                                                                                                                                                                                                                                environment:
                                                                                                                                                                                                                                                                                      NEXT_PUBLIC_API_URL: http://localhost:8000/api/v1
                                                                                                                                                                                                                                                                                          volumes:
                                                                                                                                                                                                                                                                                                - ./frontend:/app
                                                                                                                                                                                                                                                                                                      - /app/node_modules
                                                                                                                                                                                                                                                                                                            - /app/.next
                                                                                                                                                                                                                                                                                                                command: npm run dev

                                                                                                                                                                                                                                                                                                                volumes:
                                                                                                                                                                                                                                                                                                                  postgres_data: